{
  "name": "@from-trees/ui",
  "version": "0.11.0",
  "description": "Shared React and StyleX components for From Trees applications",
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "src",
    "tooling",
    "README.md"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./tokens.stylex": {
      "types": "./src/tokens.stylex.ts",
      "import": "./src/tokens.stylex.ts"
    },
    "./vite": {
      "types": "./tooling/vite.d.mts",
      "import": "./tooling/vite.mjs"
    },
    "./utilities": {
      "types": "./src/utilities.ts",
      "import": "./src/utilities.ts"
    },
    "./table-query": {
      "types": "./src/tableQuery.ts",
      "import": "./src/tableQuery.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "@stylexjs/stylex": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "vite": "^6.2.4 || ^7.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react-aria-components": "^1.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/from-trees/design-system.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
