{
  "name": "from-trees-design-system",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @from-trees/catalog --",
    "build": "npm run build -w @from-trees/ui && npm run build -w @from-trees/catalog",
    "typecheck": "tsc --noEmit && tsc -p packages/ui/tsconfig.build.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run lint && npm run build && npm run typecheck && npm test && npm run package:check",
    "package:check": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@stylexjs/eslint-plugin": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "jsdom": "^27.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
